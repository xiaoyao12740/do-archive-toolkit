<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶栏：app 名（跟随主题，磨砂；ActionBar 已去掉） -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_schedule"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_tier_hint"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="#888888" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/rgTierRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbLow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tier_low" />
                <RadioButton
                    android:id="@+id/rbMed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tier_mid" />
                <RadioButton
                    android:id="@+id/rbHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tier_high" />
                <RadioButton
                    android:id="@+id/rbAuto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/tier_auto" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/rgTierRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbCustom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/tier_custom" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tier_custom_hint"
                android:textSize="12sp"
                android:textColor="#888888" />

            <EditText
                android:id="@+id/etCustomTier"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:text="2" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_tier_desc"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:textColor="#777777" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E4EA"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <!-- 语言切换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_lang_title"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_lang_hint"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <Switch
                android:id="@+id/swLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 主题颜色 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_theme_title"
            android:textSize="15sp"
            android:textColor="#1A1A1A"
            android:paddingTop="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_theme_hint"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnThemePurple"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_purple" />
            <Button
                android:id="@+id/btnThemeNight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_night" />
            <Button
                android:id="@+id/btnThemeEye"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_eye" />
            <Button
                android:id="@+id/btnThemeKraft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_kraft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnThemeBlue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_blue" />
            <Button
                android:id="@+id/btnThemeTeal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_teal" />
            <Button
                android:id="@+id/btnThemePink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_pink" />
            <Button
                android:id="@+id/btnThemeOrange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_orange" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnThemeRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_red" />
            <Button
                android:id="@+id/btnThemeGray"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_gray" />
            <Button
                android:id="@+id/btnThemeMint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_mint" />
            <Button
                android:id="@+id/btnThemeCream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_cream" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnThemeCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:maxLines="1"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/theme_custom" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnThemeBg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:maxLines="1"
                android:minHeight="48dp"
                android:gravity="center"
                android:text="@string/theme_custom_bg" />
            <Button
                android:id="@+id/btnThemeFont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:maxLines="1"
                android:minHeight="48dp"
                android:gravity="center"
                android:text="@string/theme_custom_font" />
        </LinearLayout>

        <!-- 应用图标 DIY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_icon_title"
            android:textSize="15sp"
            android:textColor="#1A1A1A"
            android:paddingTop="10dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_icon_hint"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前图标："
                android:textSize="12sp"
                android:textColor="#888888" />
            <ImageView
                android:id="@+id/imgCurrentIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/icon_preset_thinker"
                android:scaleType="fitCenter"
                android:background="#22000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconRock"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/icon_preset_rock"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:background="#22000000"
                android:clickable="true"
                android:focusable="true" />
            <ImageView
                android:id="@+id/iconPc"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/icon_preset_pc"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:background="#22000000"
                android:clickable="true"
                android:focusable="true" />
            <ImageView
                android:id="@+id/iconMonitor"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/icon_preset_monitor"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:background="#22000000"
                android:clickable="true"
                android:focusable="true" />
            <ImageView
                android:id="@+id/iconPhone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/icon_preset_phone"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:background="#22000000"
                android:clickable="true"
                android:focusable="true" />
            <ImageView
                android:id="@+id/iconThinker"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:src="@drawable/icon_preset_thinker"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:background="#22000000"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btnIconSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#FF6200EE"
            android:textColor="#FFFFFF"
            android:text="@string/set_icon_save" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E4EA"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_notif_detail"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_notif_detail_hint"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <Switch
                android:id="@+id/swNotifDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_finish_notif"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_finish_notif_hint"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <Switch
                android:id="@+id/swFinishNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_auto_export"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_auto_export_hint"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <Switch
                android:id="@+id/swAutoExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_scan_subdir"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_scan_subdir_hint"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>

            <Switch
                android:id="@+id/swScanSubdir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E4EA"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/set_max_depth"
                android:textSize="15sp"
                android:textColor="#1A1A1A" />

            <EditText
                android:id="@+id/etMaxDepth"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="2"
                android:text="10"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/tvAbout"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
